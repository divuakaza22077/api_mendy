{
  "name": "api-mend-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "sync:fixtures": "node scripts/sync-fixtures.mjs",
    "dev": "vite --config frontend/vite.config.ts",
    "prebuild": "npm run sync:fixtures",
    "build": "vite --config frontend/vite.config.ts build",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "lint:target": "oxlint frontend/src"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-diff-viewer-continued": "4.4.0",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
